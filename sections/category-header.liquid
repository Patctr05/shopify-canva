{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div 
  class="category-header-section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  id="{{ section.settings.section_id }}"
>
  <div class="page-width">
    <h2 class="category-header-title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ section.settings.title | escape }}
    </h2>
    {%- if section.settings.description != blank -%}
      <p class="category-header-description{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {{ section.settings.description | escape }}
      </p>
    {%- endif -%}
  </div>
</div>

<style>
  .category-header-section {
    text-align: center;
    border-top: 1px solid rgba(0,0,0,0.08);
  }
  .category-header-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
  }
  .category-header-description {
    color: #666;
    font-size: 1rem;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  @media screen and (max-width: 749px) {
    .category-header-title {
      font-size: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Category Header",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Category Title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "section_id",
      "default": "category-section",
      "label": "Section ID",
      "info": "Used for navigation links (e.g., mens-tshirts-section)"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Category Header"
    }
  ]
}
{% endschema %}
